{
  "__version__": "1.3.9",
  "builder": {
    "options": {
      "web-desktop": {
        "useWebGPU": false,
        "resolution": {
          "designWidth": 1920,
          "designHeight": 1080
        }
      },
      "wechatgame": {
        "orientation": "landscape"
      }
    }
  },
  "bundleConfig": {
    "custom": {
      "wizzard-wechat-resources-v1": {
        "displayName": "WeChat resources subpackage",
        "configs": {
          "native": {
            "preferredOptions": {
              "compressionType": "merge_dep",
              "isRemote": false
            }
          },
          "miniGame": {
            "configMode": "overwrite",
            "overwriteSettings": {
              "wechatgame": {
                "compressionType": "subpackage",
                "isRemote": false
              }
            }
          },
          "web": {
            "preferredOptions": {
              "compressionType": "merge_dep",
              "isRemote": false
            }
          }
        }
      }
    }
  }
}
