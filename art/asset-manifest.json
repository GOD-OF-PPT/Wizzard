      "friendRoomAiRowV2": {
        "pixelSize": [1080, 152],
        "renderMode": "simple",
        "contentSafeRect": [120, 22, 840, 108],
        "notes": "Final-ratio AI auto-fill control with an ornament-free center."
      }
    },
    "nineSliceInsets": {
      "roundTitleScroll": { "left": 64, "right": 64, "top": 72, "bottom": 72 },
      "primaryPanel": { "left": 80, "right": 80, "top": 52, "bottom": 52 },
      "secondaryPanel": { "left": 64, "right": 64, "top": 42, "bottom": 42 },
