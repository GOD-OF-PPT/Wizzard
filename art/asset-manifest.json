      "trumpTile": "ui.trumpTile",
      "countdownRing": "ui.countdownRing",
      "aiBadge": "ui.badge.ai",
      "bidDots": "ui.bidDots",
      "scoreRibbon": "ui.scoreRibbon"
    },
    "renderContracts": {
      "gameplayStatPaper": {
        "pixelSize": [600, 168],
        "renderMode": "simple",
        "contentSafeRect": [70, 18, 460, 132]
      },
      "gameplayStatGreen": {
        "pixelSize": [600, 168],
        "renderMode": "simple",
        "contentSafeRect": [100, 18, 455, 132]
      },
      "roundResultsPanel": {
        "pixelSize": [1710, 920],
        "renderMode": "simple",
        "contentSafeRect": [250, 160, 1210, 650],
        "notes": "Dedicated Mini Game results panel with baked empty title/header/row bands; flowers stay outside the runtime table columns."
      },
      "scoreButtonPaper": {
        "pixelSize": [480, 200],
        "renderMode": "simple",
        "contentSafeRect": [80, 30, 320, 140]
      },
      "scoreButtonGreenV2": {
        "pixelSize": [600, 200],
        "renderMode": "simple",
        "contentSafeRect": [60, 30, 480, 140],
        "notes": "Versioned cache-busting runtime path. Full-height lacquer plaque with all decoration contained inside the frame; runtime labels may stay optically centered."
      },
      "friendRoomCreatePanelV2": {
        "pixelSize": [1482, 1062],
        "renderMode": "simple",
        "contentSafeRect": [100, 100, 1282, 862],
        "notes": "Dedicated final-ratio create-room modal. Dynamic title, avatars, fields, AI-fill control, mode controls, and actions stay runtime-rendered."
      },
      "friendRoomJoinPanelV2": {
        "pixelSize": [1601, 982],
        "renderMode": "simple",
        "contentSafeRect": [100, 90, 1401, 802],
        "notes": "Dedicated final-ratio join-room modal with a quiet center and versioned Mini Game cache-busting path."
      },
      "friendRoomInputRowV2": {
        "pixelSize": [1400, 152],
        "renderMode": "simple",
        "contentSafeRect": [120, 22, 1160, 108],
        "notes": "Final-ratio nickname input row with an ornament-free center."
