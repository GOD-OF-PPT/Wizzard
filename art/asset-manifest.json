{
  "version": 5,
  "artDirection": "enchanted-teahouse",
  "orientation": "landscape",
  "designViewport": [1920, 1080],
  "reference": "art/reference/gameplay-selected.png",
  "mockups": {
    "home": "art/mockups/home-screen.png",
    "friendRoom": "art/mockups/friend-room-screen.png",
    "gameplay": "art/mockups/gameplay-screen.png",
    "roundResults": "art/mockups/round-results-screen.png"
  },
  "cocos38": {
    "semanticKeyConvention": "domain.category.name[.state]",
    "defaultAnchor": [0.5, 0.5],
    "atlas": {
      "maxSize": [2048, 2048],
      "padding": 4,
      "extrude": 2,
      "allowRotation": false
    },
    "importProfiles": {
      "opaqueIllustration": {
        "preferredCompression": "ASTC_6x6",
        "fallbackCompression": "ETC2_RGB8",
        "filter": "linear",
        "mipmap": false,
        "trim": false
      },
      "alphaUi": {
        "preferredCompression": "ASTC_4x4",
        "fallbackCompression": "RGBA8888",
        "filter": "linear",
        "mipmap": false,
        "trim": false,
        "premultiplyAlpha": false
      },
      "background": {
        "preferredCompression": "ASTC_8x8",
        "fallbackCompression": "ETC2_RGB8",
        "filter": "linear",
        "mipmap": false,
        "trim": false
      }
    }
  },
  "backgrounds": {
    "home": {
      "semanticKey": "screen.home",
      "source": "art/mockups/home-screen.png",
      "runtime": "art/runtime/backgrounds/home-screen-hd.png",
      "pixelSize": [1920, 1080],
      "anchor": [0.5, 0.5],
      "importProfile": "background"
    },
    "homeWechatUltrawide": {
      "semanticKey": "screen.home.wechat.ultrawide",
      "source": "art/source/backgrounds/home-screen-wechat-ultrawide-master.png",
      "runtime": "art/runtime/backgrounds/home-screen-wechat-ultrawide.png",
      "pixelSize": [2560, 1080],
      "anchor": [0.5, 0.5],
      "importProfile": "background",
      "notes": "Single continuous WeChat Mini Game home master for ultra-wide landscape devices; no runtime side-extension stitching."
    },
    "table": {
      "semanticKey": "scene.teahouse.table",
      "runtime": "art/runtime/backgrounds/teahouse-table.png",
      "pixelSize": [1920, 1080],
      "anchor": [0.5, 0.5],
      "importProfile": "background"
    }
  },
  "cards": {
    "sourcePixelSize": [1024, 1536],
    "runtimePixelSize": [256, 384],
    "anchor": [0.5, 0.5],
    "importProfile": "opaqueIllustration",
    "allowAtlasRotation": false,
    "numericOverlayRange": [1, 13],
    "items": {
      "back": {
        "semanticKey": "card.back",
        "source": "art/source/cards/card-back-master.png",
        "runtime": "art/runtime/cards/card-back.png"
      },
      "mountain": {
        "semanticKey": "card.face.mountain",
        "source": "art/source/cards/mountain-face-master.png",
        "runtime": "art/runtime/cards/mountain-face.png"
      },
      "knot": {
        "semanticKey": "card.face.knot",
        "source": "art/source/cards/knot-face-master.png",
        "runtime": "art/runtime/cards/knot-face.png"
      },
      "leaf": {
        "semanticKey": "card.face.leaf",
        "source": "art/source/cards/leaf-face-master.png",
        "runtime": "art/runtime/cards/leaf-face.png"
      },
      "sun": {
        "semanticKey": "card.face.sun",
        "source": "art/source/cards/sun-face-master.png",
        "runtime": "art/runtime/cards/sun-face.png"
      },
      "highest": {
        "semanticKey": "card.special.highest",
        "source": "art/source/cards/highest-special-master.png",
        "runtime": "art/runtime/cards/highest-special.png"
      },
      "lowest": {
        "semanticKey": "card.special.lowest",
        "source": "art/source/cards/lowest-special-master.png",
        "runtime": "art/runtime/cards/lowest-special.png"
      }
    },
    "localizedRetouches": [
      "card.back",
      "card.face.knot",
      "card.special.highest"
    ],
    "colors": {
      "mountain": "#243F66",
      "knot": "#B63A2E",
      "leaf": "#2F7F78",
      "sun": "#C88724"
    }
  },
  "avatars": {
    "sourcePixelSize": [1024, 1024],
    "runtimePixelSize": [512, 512],
    "displayPixelSize": [160, 160],
    "anchor": [0.5, 0.5],
    "importProfile": "alphaUi",
    "expressions": ["normal", "thinking", "proud", "mistake"],
    "expressionSemanticKeyPattern": "avatar.{character}.{expression}",
    "cropCleanup": "all quadrant divider lines removed before runtime export",
    "characters": {
      "bambooCat": {
        "semanticKey": "avatar.bambooCat",
        "source": {
          "normal": "art/source/avatars/bamboo-cat/normal.png",
          "thinking": "art/source/avatars/bamboo-cat/thinking.png",
          "proud": "art/source/avatars/bamboo-cat/proud.png",
          "mistake": "art/source/avatars/bamboo-cat/mistake.png"
        },
        "runtime": {
          "normal": "art/runtime/avatars/bamboo-cat/normal.png",
          "thinking": "art/runtime/avatars/bamboo-cat/thinking.png",
          "proud": "art/runtime/avatars/bamboo-cat/proud.png",
          "mistake": "art/runtime/avatars/bamboo-cat/mistake.png"
        }
      },
      "wanderingCrane": {
        "semanticKey": "avatar.wanderingCrane",
