  "social": {
    "wechatShareCardV1": {
      "semanticKey": "social.wechat.shareCard.v1",
      "source": "art/source/social/wechat-share-card-v1.png",
      "runtime": "art/runtime/social/wechat-share-card-v1.jpg",
      "buildPath": "share-card-v1.jpg",
