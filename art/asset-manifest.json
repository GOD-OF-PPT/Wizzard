    "semanticKeys": {
      "roundTitleScroll": "ui.roundTitleScroll",
      "gameplayStatPaper": "ui.match.stat.paper",
      "gameplayStatGreen": "ui.match.stat.green",
      "roundResultsPanel": "ui.results.panel",
