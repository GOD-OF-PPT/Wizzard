# Friend-room service
WIZZARD_ROOM_PORT=8787

# Comma-separated HTTP(S) origins allowed to open /ws in production.
# WIZZARD_ALLOWED_ORIGINS=https://game.example.com,https://servicewechat.com

# Omit for the default single-process in-memory repository.
# Set this for restart-safe room persistence on the single active service.
WIZZARD_REDIS_URL=redis://127.0.0.1:6379
